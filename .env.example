# =============================================================================
# CampusFlow — Environment Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER commit .env, .env.production, or .env.supabase
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (local development MUST remain localhost) ───────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bmsce_academic?schema=public

# ── Redis (omit in free-tier cloud; API uses in-memory fallback) ─────────────
REDIS_URL=redis://localhost:6379

# ── Optimizer Service (optional; API falls back if unreachable) ──────────────
OPTIMIZER_URL=http://localhost:8000

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_STRONG_64_CHAR_RANDOM_SECRET
CORS_ORIGIN=http://localhost:5173

# ── Demo flags ───────────────────────────────────────────────────────────────
# Local: IS_DEMO_ENV=true enables persona switcher (x-demo-role never works in production)
IS_DEMO_ENV=true
# Cloud demo: set ALLOW_DEMO_AUTH=true so /auth/demo-login works with NODE_ENV=production
ALLOW_DEMO_AUTH=false
INITIAL_DATA_MODE=SYNTHETIC
# bcrypt hash of the shared demo password (generate with: node -e "require('bcryptjs').hash('YOUR_PASSWORD',10).then(console.log)")
DEMO_PASSWORD_HASH=

# ── Frontend (Vite — baked in at build time) ────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_SOCKET_URL=http://localhost:3001

# ── Supabase one-shot scripts (never put these in local .env) ───────────────
# SUPABASE_SESSION_POOLER_URI=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# SUPABASE_PROJECT_REF=ctxpnicaqjygakszmhgs
# SUPABASE_EXPECTED_HOST=aws-1-ap-south-1.pooler.supabase.com
# ALLOW_SUPABASE_SEED=false
