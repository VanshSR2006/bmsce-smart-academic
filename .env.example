# =============================================================================
# BMSCE Smart Academic — Environment Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER commit .env to version control
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Database ─────────────────────────────────────────────────────────────────
# In Docker production, use the service name "postgres" instead of "localhost"
DATABASE_URL=postgresql://DBUSER:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/bmsce_academic?schema=public

# ── Redis ────────────────────────────────────────────────────────────────────
# In Docker production, use the service name "redis" instead of "localhost"
REDIS_URL=redis://redis:6379

# ── Optimizer Service ────────────────────────────────────────────────────────
# In Docker production, use the service name "optimizer" instead of "localhost"
OPTIMIZER_URL=http://optimizer:8000

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED: Replace with a cryptographically random string of 64+ characters
# Generate one with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_USE_STRONG_64_CHAR_RANDOM_SECRET

# Allowed CORS origin for the API (must match your production domain)
CORS_ORIGIN=https://academic.bmsce.ac.in

# ── Feature Flags ────────────────────────────────────────────────────────────
# MUST be false or omitted in production — demo auth bypasses real authentication
IS_DEMO_ENV=false

# Data seeding mode: PRODUCTION (real data) or SYNTHETIC (demo data)
INITIAL_DATA_MODE=PRODUCTION

# ── Frontend (Vite — set at build time, not runtime) ─────────────────────────
# Full public URL to the API, as seen by browsers
VITE_API_BASE_URL=https://academic.bmsce.ac.in/api/v1
# Full public URL to the API for Socket.IO connections
VITE_SOCKET_URL=https://academic.bmsce.ac.in
